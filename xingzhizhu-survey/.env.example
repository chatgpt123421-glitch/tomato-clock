# 本文件只放变量名和示例，不放真实密钥。

# 问卷提交后推送到飞书群的机器人 Webhook。
FEISHU_WEBHOOK=

# 问卷提交后自动同步客户摘要到飞书表格。
# 这不是群机器人 Webhook，需要飞书开放平台应用凭证和目标表格信息。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_SUMMARY_SPREADSHEET_TOKEN=
FEISHU_SUMMARY_SHEET_ID=
FEISHU_SUMMARY_SYNC_ROWS=200

# 线上域名，不带尾部斜杠。用于飞书通知里的报告链接。
BASE_URL=https://xingzhizhu-survey.onrender.com

# 线上 PostgreSQL 连接地址。未配置时会回退到本地 survey.db。
DATABASE_URL=

# 后台密码。配置后 /admin、客户列表 API 和 CSV 导出需要登录。
ADMIN_PASSWORD=

# 本地默认 8000；Render 通常自动提供。
PORT=8000
